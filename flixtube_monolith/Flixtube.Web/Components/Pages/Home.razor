@page "/"
@inject RestService RestService

<PageTitle>Video List</PageTitle>

<div class="mt-2">
    <a class="btn btn-primary" role="button" href="/upload">Upload Video</a>
    <a class="btn btn-primary" role="button" href="/history">Show Viewing History</a>
</div>

@if (videos is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped table-bordered table-hover caption-top mt-3">
        <caption style="font-size: 1.5em" class="text-left text-primary font-weight-bold mt-2 mb-1">Videos</caption>
        <thead class="table-dark">
            <tr>
                <th class="text-end">Id</th>
                <th>Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var video in videos)
            {
                <tr>
                    <td class="text-end">@video.Id</td>
                    <td>@video.Name</td>
                    <td>
                        <div class="d-flex">
                            <a class="btn btn-primary me-2" role="button" href="@VideoUrl(video.Id)">
                                <i class="bi bi-play"></i>
                            </a>
                            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="@GetDeleteModalId(video)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <DeleteVideo Video="@video" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code
{
    private List<Video>? videos;

    protected async override Task OnInitializedAsync()
    {
        videos = await RestService.GetMetadataAsync();
    }

    private static string VideoUrl(string id) => $"/playvideo/{id}";

    private string GetDeleteModalId(Video video)
    {
        return $"#{DeleteVideo.GetModalId(video)}";
    }
}